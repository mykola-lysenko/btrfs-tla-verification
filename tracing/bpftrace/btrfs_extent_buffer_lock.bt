#!/usr/bin/env bpftrace
/*
 * btrfs_extent_buffer_lock.bt
 *
 * Traces Btrfs extent buffer lock/unlock events relevant to the
 * BtrfsExtentBufferLock.tla model (ABBA deadlock via lock inversion).
 *
 * TLA+ model variables mapped:
 *   eb_wlock[l]        <- 0 (free) or tid (held) per level
 *   thread_held[t]     <- set of levels currently held by thread t
 *   thread_pc[t]       <- derived from function entry/exit
 *
 * Safety invariant checked: NoDeadlock
 *   -> No two threads hold locks such that each is waiting for
 *      a lock held by the other (top-down ordering must be preserved).
 *
 * Kernel functions traced (fs/btrfs/locking.c, Linux 6.x):
 *   btrfs_tree_lock          - acquire write lock on extent buffer
 *   btrfs_tree_unlock        - release write lock
 *   btrfs_tree_read_lock     - acquire read lock
 *   btrfs_tree_read_unlock   - release read lock
 *   btrfs_try_tree_write_lock - non-blocking write lock attempt
 *
 * Output: one JSON object per event on stdout.
 *
 * Usage:
 *   sudo bpftrace btrfs_extent_buffer_lock.bt | tee trace.jsonl
 *   python3 ../checkers/btrfs_extent_buffer_lock_checker.py < trace.jsonl
 */

BEGIN {
    printf("# btrfs_extent_buffer_lock trace started.\n");
    printf("# Invariant: top-down lock ordering (parent before child)\n");
}

/*
 * btrfs_tree_lock(struct extent_buffer *eb, int nest)
 * struct extent_buffer: level at offset 0x1c (u8, kernel 6.x)
 *                       start (bytenr) at offset 0x0
 */
kprobe:btrfs_tree_lock {
    $eb    = (struct extent_buffer *)arg0;
    $level = (uint8)$eb->level;
    $start = $eb->start;
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"AcquireWrite\",\"level\":%d,\"bytenr\":%llu}\n",
        nsecs, tid, comm, $level, $start);
    @lock_start[tid, $level] = nsecs;
    /* Track held set per thread for ordering check */
    @held_levels[tid] = @held_levels[tid] | (1 << $level);
}

kretprobe:btrfs_tree_lock {
    /* Lock acquired — record in held map */
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"AcquireWrite_Done\"}\n",
        nsecs, tid, comm);
}

kprobe:btrfs_tree_unlock {
    $eb    = (struct extent_buffer *)arg0;
    $level = (uint8)$eb->level;
    $start = $eb->start;
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"Release\",\"level\":%d,\"bytenr\":%llu}\n",
        nsecs, tid, comm, $level, $start);
    @held_levels[tid] = @held_levels[tid] & ~(1 << $level);
    delete(@lock_start[tid, $level]);
}

kprobe:btrfs_tree_read_lock {
    $eb    = (struct extent_buffer *)arg0;
    $level = (uint8)$eb->level;
    $start = $eb->start;
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"AcquireRead\",\"level\":%d,\"bytenr\":%llu}\n",
        nsecs, tid, comm, $level, $start);
}

kretprobe:btrfs_tree_read_lock {
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"AcquireRead_Done\"}\n",
        nsecs, tid, comm);
}

kprobe:btrfs_tree_read_unlock {
    $eb    = (struct extent_buffer *)arg0;
    $level = (uint8)$eb->level;
    $start = $eb->start;
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"ReleaseRead\",\"level\":%d,\"bytenr\":%llu}\n",
        nsecs, tid, comm, $level, $start);
}

kprobe:btrfs_try_tree_write_lock {
    $eb    = (struct extent_buffer *)arg0;
    $level = (uint8)$eb->level;
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"TryAcquireWrite\",\"level\":%d}\n",
        nsecs, tid, comm, $level);
}

kretprobe:btrfs_try_tree_write_lock {
    printf("{\"ts\":%llu,\"tid\":%d,\"comm\":\"%s\",\"action\":\"TryAcquireWrite_Done\",\"success\":%d}\n",
        nsecs, tid, comm, (int32)retval);
}

END {
    clear(@lock_start);
    clear(@held_levels);
    printf("# btrfs_extent_buffer_lock trace ended.\n");
}
