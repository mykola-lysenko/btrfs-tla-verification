#!/usr/bin/env bpftrace
/*
 * btrfs_dev_replace.bt  [tracepoint edition]
 * --------------------------------------------
 * Traces Btrfs device replace operations.
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsDevReplace.tla
 * Invariant:  NoLostWrite — writes during replace must appear on new device
 *
 * Tracepoints:
 *   btrfs:btrfs_chunk_alloc  — chunk allocated (new device gets chunk)
 *   btrfs:btrfs_chunk_free   — chunk freed (old device chunk removed)
 *   btrfs:btrfs_reserved_extent_alloc — extent allocated
 *   btrfs:btrfs_reserved_extent_free  — extent freed
 *   btrfs:btrfs_transaction_commit    — transaction committed
 *
 * Usage:
 *   sudo bpftrace btrfs_dev_replace.bt
 */

BEGIN {
    printf("# btrfs_dev_replace.bt [tracepoint] started\n");
}

tracepoint:btrfs:btrfs_chunk_alloc {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ChunkAlloc\",\"offset\":%llu,\"size\":%llu,\"type\":%llu,\"ts\":%llu}\n",
        tid, comm, args->offset, args->size, args->type, nsecs);
    @active_chunks[args->offset] = args->size;
}

tracepoint:btrfs:btrfs_chunk_free {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ChunkFree\",\"offset\":%llu,\"size\":%llu,\"type\":%llu,\"ts\":%llu}\n",
        tid, comm, args->offset, args->size, args->type, nsecs);
    delete(@active_chunks[args->offset]);
}

tracepoint:btrfs:btrfs_reserved_extent_alloc {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentAlloc\",\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
}

tracepoint:btrfs:btrfs_reserved_extent_free {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentFree\",\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
}

tracepoint:btrfs:btrfs_transaction_commit {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"TransactionCommit\",\"gen\":%llu,\"ts\":%llu}\n",
        tid, comm, args->generation, nsecs);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\",\"active_chunks\":%lld,\"ts\":%llu}\n",
        count(@active_chunks), nsecs);
}

END {
    clear(@active_chunks);
    printf("# btrfs_dev_replace.bt ended\n");
}
