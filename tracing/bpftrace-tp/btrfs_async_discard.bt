#!/usr/bin/env bpftrace
/*
 * btrfs_async_discard.bt  [tracepoint edition]
 * ----------------------------------------------
 * Traces Btrfs async discard (TRIM) operations.
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsAsyncDiscard.tla
 * Invariant:  NoDiscardLiveExtent — must not discard an allocated extent
 *
 * Tracepoints:
 *   btrfs:btrfs_reserved_extent_alloc — extent allocated (must not be discarded)
 *   btrfs:btrfs_reserved_extent_free  — extent freed (eligible for discard)
 *   btrfs:btrfs_add_unused_block_group — block group unused (discard candidate)
 *   btrfs:btrfs_remove_block_group    — block group removed (discard complete)
 *   btrfs:btrfs_transaction_commit    — transaction committed (frees pinned extents)
 *
 * Discard safety check:
 *   An extent must not be discarded (block group removed) while it is still
 *   allocated. We track allocated extents and check that they are freed
 *   before the block group containing them is removed.
 *
 * Usage:
 *   sudo bpftrace btrfs_async_discard.bt
 */

BEGIN {
    printf("# btrfs_async_discard.bt [tracepoint] started\n");
}

tracepoint:btrfs:btrfs_reserved_extent_alloc {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentAlloc\","
           "\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
    @allocated[args->start] = args->len;
}

tracepoint:btrfs:btrfs_reserved_extent_free {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentFree\","
           "\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
    delete(@allocated[args->start]);
    @freed[args->start] = nsecs;
}

tracepoint:btrfs:btrfs_add_unused_block_group {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"UnusedBlockGroup\","
           "\"bytenr\":%llu,\"len\":%llu,\"flags\":%llu,\"ts\":%llu}\n",
        tid, comm, args->bytenr, args->len, args->flags, nsecs);
    @discard_pending[args->bytenr] = args->len;
}

tracepoint:btrfs:btrfs_remove_block_group {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"RemoveBlockGroup\","
           "\"bytenr\":%llu,\"len\":%llu,\"flags\":%llu,\"ts\":%llu}\n",
        tid, comm, args->bytenr, args->len, args->flags, nsecs);

    /* Check if any allocated extent falls within this block group */
    /* (full check done by Python checker; inline check for same-thread) */
    if (@allocated[args->bytenr] != 0) {
        printf("{\"tid\":%d,\"action\":\"VIOLATION_DiscardLiveExtent\","
               "\"bg_start\":%llu,\"ts\":%llu}\n",
            tid, args->bytenr, nsecs);
    }
    delete(@discard_pending[args->bytenr]);
}

tracepoint:btrfs:btrfs_transaction_commit {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"TransactionCommit\","
           "\"gen\":%llu,\"ts\":%llu}\n",
        tid, comm, args->generation, nsecs);
    /* After commit, pinned extents are released — clear freed map */
    clear(@freed);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\","
           "\"allocated\":%lld,\"discard_pending\":%lld,\"ts\":%llu}\n",
        count(@allocated), count(@discard_pending), nsecs);
}

END {
    clear(@allocated); clear(@freed); clear(@discard_pending);
    printf("# btrfs_async_discard.bt ended\n");
}
