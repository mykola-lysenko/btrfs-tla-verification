#!/usr/bin/env bpftrace
/*
 * btrfs_scrub.bt  [tracepoint edition]
 * --------------------------------------
 * Traces Btrfs scrub operations (data integrity verification).
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsScrub.tla
 * Invariant:  NoMissedRepair — corrupted extents must be repaired before scrub ends
 *
 * Tracepoints:
 *   btrfs:btrfs_reserved_extent_alloc — extent allocated (written during repair)
 *   btrfs:btrfs_reserved_extent_free  — extent freed (old copy after repair)
 *   btrfs:btrfs_cow_block             — COW during repair (tree update)
 *   btrfs:btrfs_transaction_commit    — transaction committed (repair persisted)
 *
 * NOTE: There are no dedicated scrub tracepoints in kernel 6.9.
 * We use extent alloc/free + cow_block as proxies for the repair path.
 * The scrub process reads each extent, checksums it, and if corrupt,
 * allocates a new extent, copies data, and frees the old one.
 * Pattern: ExtentAlloc(new) -> COWBlock -> TransactionCommit -> ExtentFree(old)
 *
 * Usage:
 *   sudo bpftrace btrfs_scrub.bt
 */

BEGIN {
    printf("# btrfs_scrub.bt [tracepoint] started\n");
}

tracepoint:btrfs:btrfs_reserved_extent_alloc {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentAlloc\","
           "\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
    @alloc_pending[args->start] = nsecs;
}

tracepoint:btrfs:btrfs_reserved_extent_free {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentFree\","
           "\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
    delete(@alloc_pending[args->start]);
}

tracepoint:btrfs:btrfs_cow_block {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"COWBlock\","
           "\"root\":%llu,\"buf_block\":%llu,\"buf_level\":%d,"
           "\"cow_block\":%llu,\"ts\":%llu}\n",
        tid, comm,
        args->root_objectid, args->buf_start, args->buf_level,
        args->cow_start, nsecs);
}

tracepoint:btrfs:btrfs_transaction_commit {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"TransactionCommit\","
           "\"gen\":%llu,\"ts\":%llu}\n",
        tid, comm, args->generation, nsecs);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\","
           "\"pending_allocs\":%lld,\"ts\":%llu}\n",
        count(@alloc_pending), nsecs);
}

END {
    clear(@alloc_pending);
    printf("# btrfs_scrub.bt ended\n");
}
