#!/usr/bin/env bpftrace
/*
 * btrfs_cow_path.bt  [tracepoint edition]
 * -----------------------------------------
 * Traces Btrfs COW (Copy-On-Write) path operations.
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsCOWPath.tla
 * Invariant:  NoUAF — tree block must not be freed while COW path traverses it
 *
 * Tracepoints:
 *   btrfs:btrfs_cow_block           — a tree block is being COWed
 *   btrfs:btrfs_reserved_extent_free — an extent (tree block) is freed
 *   btrfs:btrfs_reserved_extent_alloc — an extent (tree block) is allocated
 *   btrfs:add_delayed_tree_ref      — delayed tree ref added (free scheduled)
 *   btrfs:run_delayed_tree_ref      — delayed tree ref executed (free happens)
 *
 * UAF detection:
 *   When btrfs_cow_block fires for buf_start=X, thread T is traversing
 *   block X. If run_delayed_tree_ref fires for bytenr=X with action=DROP
 *   while T is still in the COW path, that is the UAF window.
 *
 * Usage:
 *   sudo bpftrace btrfs_cow_path.bt
 */

BEGIN {
    printf("# btrfs_cow_path.bt [tracepoint] started\n");
    @DROP_REF = 2;
}

/* COW block: thread T is traversing buf_start */
tracepoint:btrfs:btrfs_cow_block {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"COWBlock\",\"root\":%llu,\"buf_block\":%llu,\"buf_level\":%d,\"cow_block\":%llu,\"cow_level\":%d,\"refs\":%d,\"ts\":%llu}\n",
        tid, comm,
        args->root_objectid, args->buf_start, args->buf_level,
        args->cow_start, args->cow_level, args->refs, nsecs);

    /* Track that this thread is traversing buf_start */
    @cow_active[tid] = args->buf_start;
    @cow_level[tid]  = args->buf_level;
    @cow_ts[tid]     = nsecs;

    /* refs == 1 means this is the last reference — free is imminent */
    if (args->refs == 1) {
        @last_ref_blocks[args->buf_start] = tid;
    }
}

/* Delayed tree ref added — a DROP_REF schedules a future free */
tracepoint:btrfs:add_delayed_tree_ref {
    if (args->action == @DROP_REF) {
        printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"AddDelayedDrop\",\"bytenr\":%llu,\"level\":%d,\"ts\":%llu}\n",
            tid, comm, args->bytenr, args->level, nsecs);
        @pending_free[args->bytenr] = tid;
    }
}

/* Delayed tree ref executed — the actual free happens here */
tracepoint:btrfs:run_delayed_tree_ref {
    if (args->action == @DROP_REF) {
        printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"RunDelayedDrop\",\"bytenr\":%llu,\"level\":%d,\"ts\":%llu}\n",
            tid, comm, args->bytenr, args->level, nsecs);

        /*
         * UAF check: is any thread currently COWing this block?
         * We can't iterate @cow_active in bpftrace, but we can check
         * if this thread itself was COWing it (same tid = safe).
         * Cross-thread detection is done by the Python checker.
         */
        delete(@pending_free[args->bytenr]);
        delete(@last_ref_blocks[args->bytenr]);
    }
}

/* Extent freed — the block is now invalid */
tracepoint:btrfs:btrfs_reserved_extent_free {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentFree\",\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);

    /* If this block was being COWed by this thread, that's a UAF */
    if (@cow_active[tid] == args->start) {
        printf("{\"tid\":%d,\"action\":\"VIOLATION_UAF_SameThread\",\"block\":%llu,\"ts\":%llu}\n",
            tid, args->start, nsecs);
    }
    delete(@cow_active[tid]);
    delete(@cow_level[tid]);
    delete(@cow_ts[tid]);
}

tracepoint:btrfs:btrfs_reserved_extent_alloc {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"ExtentAlloc\",\"start\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->start, args->len, nsecs);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\",\"active_cows\":%lld,\"pending_frees\":%lld,\"ts\":%llu}\n",
        count(@cow_active), count(@pending_free), nsecs);
}

END {
    clear(@cow_active); clear(@cow_level); clear(@cow_ts);
    clear(@pending_free); clear(@last_ref_blocks);
    clear(@DROP_REF);
    printf("# btrfs_cow_path.bt ended\n");
}
