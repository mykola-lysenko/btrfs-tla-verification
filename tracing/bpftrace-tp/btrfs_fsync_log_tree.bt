#!/usr/bin/env bpftrace
/*
 * btrfs_fsync_log_tree.bt  [tracepoint edition]
 * -----------------------------------------------
 * Traces Btrfs fsync and log tree operations.
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsFsyncLogTree.tla
 * Invariant:  NoLogTreeDuplicate (CVE-2024-37354)
 *
 * Tracepoints:
 *   btrfs:btrfs_sync_file           — fsync() called on a file
 *   btrfs:btrfs_ordered_extent_add  — ordered extent created (prealloc write)
 *   btrfs:btrfs_ordered_extent_lookup_for_logging — extent looked up for log
 *   btrfs:btrfs_ordered_extent_mark_finished — ordered extent finished
 *   btrfs:btrfs_transaction_commit  — transaction committed (log flushed)
 *
 * NOTE: There are no direct tracepoints for log_one_extent or
 *       btrfs_log_inode in kernel 6.9. We use ordered extent tracepoints
 *       as a proxy: the race window is between ordered_extent_add (prealloc
 *       write extends i_size) and ordered_extent_lookup_for_logging (fsync
 *       reads the extent for logging). If both fire for the same ino+offset
 *       from different threads simultaneously, the duplicate key race is live.
 *
 * Usage:
 *   sudo bpftrace btrfs_fsync_log_tree.bt | \
 *     python3 ../checkers/btrfs_fsync_log_tree_checker.py
 */

BEGIN {
    printf("# btrfs_fsync_log_tree.bt [tracepoint] started\n");
}

/* fsync() called — this is Thread A (the logger) */
tracepoint:btrfs:btrfs_sync_file {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"FsyncFile\","
           "\"ino\":%llu,\"parent\":%llu,\"root\":%llu,\"datasync\":%d,\"ts\":%llu}\n",
        tid, comm,
        args->ino, args->parent, args->root_objectid, args->datasync, nsecs);
    @fsync_active[tid] = args->ino;
    @fsync_ts[tid] = nsecs;
}

/* Ordered extent added — this is Thread B (the writer extending i_size) */
tracepoint:btrfs:btrfs_ordered_extent_add {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"OrderedExtent_Add\","
           "\"ino\":%llu,\"offset\":%llu,\"len\":%llu,\"flags\":%lu,"
           "\"compress\":%d,\"ts\":%llu}\n",
        tid, comm,
        args->ino, args->file_offset, args->len, args->flags,
        args->compress_type, nsecs);

    /* Check if a concurrent fsync is active for the same inode */
    /* (can't easily iterate @fsync_active in bpftrace, but we track the pattern) */
    @oe_active[args->ino] = tid;
    @oe_offset[args->ino] = args->file_offset;
}

/* Ordered extent looked up for logging — this is the critical point in fsync */
tracepoint:btrfs:btrfs_ordered_extent_lookup_for_logging {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"OrderedExtent_LookupForLog\","
           "\"ino\":%llu,\"offset\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm,
        args->ino, args->file_offset, args->len, nsecs);

    /*
     * Race detection: if a concurrent write (OrderedExtent_Add) is active
     * for the same inode and overlapping offset, the duplicate key race is live.
     * The writer is Thread B; the logger is Thread A (this thread).
     */
    if (@oe_active[args->ino] != 0 && @oe_active[args->ino] != tid) {
        $writer_offset = @oe_offset[args->ino];
        if ($writer_offset <= args->file_offset + args->len &&
            $writer_offset + 4096 >= args->file_offset) {
            printf("{\"tid\":%d,\"action\":\"VIOLATION_ConcurrentWriteAndLog\","
                   "\"ino\":%llu,\"log_offset\":%llu,\"write_offset\":%llu,"
                   "\"writer_tid\":%lld,\"ts\":%llu}\n",
                tid, args->ino, args->file_offset,
                $writer_offset, @oe_active[args->ino], nsecs);
        }
    }
}

/* Ordered extent finished — clears the active write record */
tracepoint:btrfs:btrfs_ordered_extent_mark_finished {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"OrderedExtent_Finished\","
           "\"ino\":%llu,\"offset\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm,
        args->ino, args->file_offset, args->len, nsecs);
    delete(@oe_active[args->ino]);
    delete(@oe_offset[args->ino]);
}

/* Ordered extent removed (completed and cleaned up) */
tracepoint:btrfs:btrfs_ordered_extent_remove {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"OrderedExtent_Remove\","
           "\"ino\":%llu,\"offset\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm,
        args->ino, args->file_offset, args->len, nsecs);
    delete(@fsync_active[tid]);
    delete(@fsync_ts[tid]);
}

/* Transaction committed — log tree flushed to disk */
tracepoint:btrfs:btrfs_transaction_commit {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"TransactionCommit\","
           "\"gen\":%llu,\"ts\":%llu}\n",
        tid, comm, args->generation, nsecs);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\","
           "\"active_fsyncs\":%lld,\"active_oe\":%lld,\"ts\":%llu}\n",
        count(@fsync_active), count(@oe_active), nsecs);
}

END {
    clear(@fsync_active); clear(@fsync_ts);
    clear(@oe_active); clear(@oe_offset);
    printf("# btrfs_fsync_log_tree.bt ended\n");
}
