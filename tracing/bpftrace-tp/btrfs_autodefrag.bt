#!/usr/bin/env bpftrace
/*
 * btrfs_autodefrag.bt  [tracepoint edition]
 * -------------------------------------------
 * Traces Btrfs autodefrag operations.
 * Verified against Linux 6.9 tracepoint ABI (bpftrace 0.25+).
 *
 * TLA+ model: BtrfsAutodefrag.tla
 * Invariant:  NoStaleDefrag — defrag must not operate on a deleted inode
 *
 * Tracepoints:
 *   btrfs:btrfs_inode_new     — inode created
 *   btrfs:btrfs_inode_evict   — inode evicted (deleted or cache eviction)
 *   btrfs:btrfs_ordered_extent_add — write to inode (defrag candidate)
 *   btrfs:btrfs_cow_block     — COW during defrag rewrite
 *   btrfs:btrfs_transaction_commit — defrag committed
 *
 * Stale defrag detection:
 *   If btrfs_cow_block fires for a root that belongs to an evicted inode,
 *   the defrag worker is operating on a stale inode reference.
 *
 * Usage:
 *   sudo bpftrace btrfs_autodefrag.bt
 */

BEGIN {
    printf("# btrfs_autodefrag.bt [tracepoint] started\n");
}

tracepoint:btrfs:btrfs_inode_new {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"InodeNew\",\"ino\":%llu,\"root\":%llu,\"ts\":%llu}\n",
        tid, comm, args->ino, args->root_objectid, nsecs);
    @live_inodes[args->ino] = args->root_objectid;
}

tracepoint:btrfs:btrfs_inode_evict {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"InodeEvict\",\"ino\":%llu,\"root\":%llu,\"ts\":%llu}\n",
        tid, comm, args->ino, args->root_objectid, nsecs);
    delete(@live_inodes[args->ino]);
    @evicted_inodes[args->ino] = nsecs;
}

tracepoint:btrfs:btrfs_ordered_extent_add {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"OrderedExtent_Add\",\"ino\":%llu,\"offset\":%llu,\"len\":%llu,\"ts\":%llu}\n",
        tid, comm, args->ino, args->file_offset, args->len, nsecs);

    /* Defrag on evicted inode */
    if (@evicted_inodes[args->ino] != 0) {
        printf("{\"tid\":%d,\"action\":\"VIOLATION_DefragEvictedInode\",\"ino\":%llu,\"evict_ts\":%llu,\"ts\":%llu}\n",
            tid, args->ino, @evicted_inodes[args->ino], nsecs);
    }
}

tracepoint:btrfs:btrfs_cow_block {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"COWBlock\",\"root\":%llu,\"buf_block\":%llu,\"buf_level\":%d,\"ts\":%llu}\n",
        tid, comm,
        args->root_objectid, args->buf_start, args->buf_level, nsecs);
}

tracepoint:btrfs:btrfs_transaction_commit {
    printf("{\"tid\":%d,\"comm\":\"%s\",\"action\":\"TransactionCommit\",\"gen\":%llu,\"ts\":%llu}\n",
        tid, comm, args->generation, nsecs);
}

interval:s:5 {
    printf("{\"action\":\"PeriodicStats\",\"live_inodes\":%lld,\"evicted_inodes\":%lld,\"ts\":%llu}\n",
        count(@live_inodes), count(@evicted_inodes), nsecs);
}

END {
    clear(@live_inodes); clear(@evicted_inodes);
    printf("# btrfs_autodefrag.bt ended\n");
}
